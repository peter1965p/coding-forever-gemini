{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "jsx": "react-jsx",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": [],
        "rootDir": "src",
        "strict": true,
        "noUnusedLocals": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["src/pages/**/*", "src/lib/vscodeApi.ts", "src/lib/theme.ts"]
}
