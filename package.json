{
    "name": "coding-forever",
    "displayName": "Coding Forever",
    "description": "Direct Gemini Flash Integration without Limits",
    "version": "2.7.1",
    "publisher": "PeterPaeffgen",
    "author": {
        "name": "Peter Päffgen",
        "email": "news24regional@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/peter1965p/coding-forever-gemini"
    },
    "icon": "media/logo.jpg",
    "engines": {
        "vscode": "^1.134.0"
    },
    "categories": [
        "AI",
        "Chat"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "codingForeverSidebar",
                    "title": "Coding Forever",
                    "icon": "media/icon.svg"
                }
            ]
        },
        "views": {
            "codingForeverSidebar": [
                {
                    "icon": "media/icon.svg",
                    "type": "webview",
                    "id": "codingForeverView",
                    "name": "AI Chat Workspace"
                }
            ]
        },
        "commands": [
            {
                "command": "coding-forever.openChatTab",
                "title": "Coding Forever: Chat Tab öffnen",
                "icon": "$(comment-discussion)"
            },
            {
                "command": "coding-forever.openDashboard",
                "title": "Coding Forever: Dashboard öffnen",
                "icon": "$(home)"
            },
            {
                "command": "coding-forever.openSettings",
                "title": "Coding Forever: Einstellungen",
                "icon": "$(gear)"
            },
            {
                "command": "coding-forever.createProject",
                "title": "Coding Forever: Node-Projekt erstellen",
                "icon": "$(new-file)"
            },
            {
                "command": "coding-forever.fixError",
                "title": "Coding Forever: Fehler beheben",
                "icon": "$(bug)"
            },
            {
                "command": "codingForever.openHistory",
                "title": "Chat History",
                "icon": "$(history)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "coding-forever.openDashboard",
                    "when": "view == codingForeverView",
                    "group": "navigation@1"
                },
                {
                    "command": "coding-forever.openSettings",
                    "when": "view == codingForeverView",
                    "group": "navigation@2"
                },
                {
                    "command": "codingForever.openHistory",
                    "when": "view == codingForeverView",
                    "group": "navigation@3"
                }
            ]
        },
        "configuration": {
            "title": "Coding Forever",
            "properties": {
                "codingForever.projectsDirectory": {
                    "type": "string",
                    "default": "",
                    "description": "Basisordner für neue Projekte. Leer verwendet ~/Dev, falls vorhanden."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "24.x",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@types/sql.js": "^1.4.11",
        "@types/vscode": "^1.134.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.0.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.5.0",
        "npm-run-all": "^4.1.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1"
    },
    "overrides": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.6"
    },
    "dependencies": {
        "@google/genai": "^2.18.0",
        "groq-sdk": "^1.6.0",
        "lucide-react": "^1.38.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "sql.js": "^1.14.2"
    }
}
