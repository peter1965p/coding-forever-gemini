{
    "name": "coding-forever",
    "displayName": "Coding Forever",
    "description": "Agentischer KI-Chat in VS Code: Gemini, Groq, Claude, OpenAI und lokale Ollama-Modelle — mit MCP-Servern, Streaming, Datei-Tools und Diff-Kontrolle.",
    "version": "3.0.1",
    "publisher": "PeterPaeffgen",
    "author": {
        "name": "Peter Päffgen",
        "email": "news24regional@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/peter1965p/coding-forever-gemini"
    },
    "icon": "media/logo.jpg",
    "engines": {
        "vscode": "^1.134.0"
    },
    "categories": [
        "AI",
        "Chat",
        "Programming Languages",
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "codingForeverSidebar",
                    "title": "Coding Forever",
                    "icon": "media/icon.svg"
                }
            ]
        },
        "views": {
            "codingForeverSidebar": [
                {
                    "icon": "media/icon.svg",
                    "type": "webview",
                    "id": "codingForeverView",
                    "name": "AI Chat Workspace"
                }
            ]
        },
        "commands": [
            {
                "command": "coding-forever.openChatTab",
                "category": "Coding Forever",
                "title": "Chat Tab öffnen",
                "icon": "$(comment-discussion)"
            },
            {
                "command": "coding-forever.openDashboard",
                "category": "Coding Forever",
                "title": "Dashboard öffnen",
                "icon": "$(home)"
            },
            {
                "command": "coding-forever.openSettings",
                "category": "Coding Forever",
                "title": "Einstellungen öffnen",
                "icon": "$(gear)"
            },
            {
                "command": "coding-forever.openHelp",
                "category": "Coding Forever",
                "title": "Hilfe öffnen",
                "icon": "$(question)"
            },
            {
                "command": "coding-forever.createProject",
                "category": "Coding Forever",
                "title": "Node-Projekt erstellen",
                "icon": "$(new-file)"
            },
            {
                "command": "coding-forever.fixError",
                "category": "Coding Forever",
                "title": "Fehler beheben",
                "icon": "$(bug)"
            },
            {
                "command": "coding-forever.sendSelection",
                "category": "Coding Forever",
                "title": "Auswahl an den Chat senden",
                "icon": "$(comment)"
            },
            {
                "command": "coding-forever.stopAgent",
                "category": "Coding Forever",
                "title": "Laufenden Agenten stoppen",
                "icon": "$(debug-stop)"
            },
            {
                "command": "coding-forever.checkUpdates",
                "category": "Coding Forever",
                "title": "Nach Updates suchen",
                "icon": "$(cloud-download)"
            },
            {
                "command": "coding-forever.reconnectMcp",
                "category": "Coding Forever",
                "title": "MCP-Server neu verbinden",
                "icon": "$(plug)"
            },
            {
                "command": "coding-forever.showLog",
                "category": "Coding Forever",
                "title": "Protokoll anzeigen",
                "icon": "$(output)"
            },
            {
                "command": "coding-forever.switchOllama",
                "category": "Coding Forever",
                "title": "Ollama-Instanzen umschalten",
                "icon": "$(server)"
            },
            {
                "command": "codingForever.openHistory",
                "category": "Coding Forever",
                "title": "Chat-Verlauf ein-/ausblenden",
                "icon": "$(history)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "coding-forever.openDashboard",
                    "when": "view == codingForeverView",
                    "group": "navigation@1"
                },
                {
                    "command": "coding-forever.openSettings",
                    "when": "view == codingForeverView",
                    "group": "navigation@2"
                },
                {
                    "command": "codingForever.openHistory",
                    "when": "view == codingForeverView",
                    "group": "navigation@3"
                },
                {
                    "command": "coding-forever.openHelp",
                    "when": "view == codingForeverView",
                    "group": "navigation@4"
                }
            ],
            "editor/context": [
                {
                    "command": "coding-forever.sendSelection",
                    "group": "navigation@9",
                    "when": "editorTextFocus"
                }
            ],
            "commandPalette": [
                {
                    "command": "coding-forever.fixError",
                    "when": "false"
                }
            ]
        },
        "configuration": {
            "title": "Coding Forever",
            "properties": {
                "codingForever.projectsDirectory": {
                    "type": "string",
                    "default": "",
                    "order": 1,
                    "markdownDescription": "Basisordner für **neue Projekte** (`Coding Forever: Node-Projekt erstellen`). Leer lassen, um `~/Dev` zu verwenden, falls vorhanden."
                },
                "codingForever.agent.maxTurns": {
                    "type": "number",
                    "default": 12,
                    "minimum": 1,
                    "maximum": 50,
                    "order": 2,
                    "markdownDescription": "Wie viele Tool-Schritte der Agent pro Anfrage höchstens macht, bevor er abbricht."
                },
                "codingForever.agent.historyDepth": {
                    "type": "number",
                    "default": 20,
                    "minimum": 0,
                    "maximum": 200,
                    "order": 3,
                    "markdownDescription": "Wie viele vorherige Chat-Nachrichten als Kontext mitgeschickt werden. `0` schaltet das Gesprächsgedächtnis ab."
                },
                "codingForever.agent.confirmDangerousCommands": {
                    "type": "boolean",
                    "default": true,
                    "order": 4,
                    "markdownDescription": "Bei riskanten Shell-Befehlen (`rm -rf`, `sudo`, `git push`, Pipe-nach-Shell …) immer nachfragen — auch wenn **Accept All** aktiv ist."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production",
        "check-types": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.webview.json",
        "lint": "eslint src",
        "test": "npm run check-types && npm run lint && npm run test:unit",
        "vsix": "npm run package && npx --yes @vscode/vsce package --no-dependencies",
        "test:unit": "node esbuild.js --tests && node --test \"out-test/*.test.js\""
    },
    "devDependencies": {
        "@types/node": "24.x",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@types/sql.js": "^1.4.11",
        "@types/vscode": "^1.134.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.5.0",
        "npm-run-all": "^4.1.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1"
    },
    "overrides": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.6"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "lucide-react": "^1.38.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-markdown": "^9.1.0",
        "react-syntax-highlighter": "^16.1.1",
        "remark-gfm": "^4.0.1",
        "sql.js": "^1.14.2"
    },
    "keywords": [
        "ai",
        "chat",
        "agent",
        "model-context-protocol",
        "mcp",
        "gemini",
        "groq",
        "claude",
        "openai",
        "ollama",
        "copilot",
        "assistant"
    ],
    "license": "MIT",
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "Der Agent kann Dateien schreiben und Befehle ausführen. In nicht vertrauenswürdigen Ordnern ist das nur eingeschränkt sinnvoll."
        }
    }
}
